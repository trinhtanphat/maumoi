{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maumoi",
  "main": "src/worker/index.js",
  "compatibility_date": "2026-08-20",
  "account_id": "46646bc5777a895df590614528828dd2",
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maumoi-db",
      "database_id": "REPLACE_AFTER_PROVISIONING",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EVIDENCE",
      "bucket_name": "maumoi-evidence"
    }
  ],
  "vars": {
    "OTP_PROVIDER": "zalo",
    "ALLOW_DEV_AUTH": "false",
    "ALLOW_DEV_OTP": "false"
  }
}
